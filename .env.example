# ---- Servidor ----
APP_NAME=churn-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Carrega o modelo no startup (false = apenas via POST /model/reload)
AUTOLOAD_MODEL=true
# Derruba a API se o modelo não carregar no startup
FAIL_FAST_ON_STARTUP=false
# Se definido, POST /model/reload exige o header X-Reload-Token
# RELOAD_TOKEN=troque-me

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=churn
MLFLOW_MODEL_NAME=churn

# Prioridade 1: alias no Model Registry
MLFLOW_MODEL_ALIAS=champion
# Prioridade 2: estágio (se o alias não existir)
# MLFLOW_MODEL_STAGE=Production
# Prioridade 0: URI explícito (sobrepõe alias/estágio)
# MLFLOW_MODEL_URI=models:/churn@champion

# ---- Fallback: melhor run do experimento ----
MODEL_SELECTION_METRIC=roc_auc
# max = quanto maior melhor; min = quanto menor melhor (ex.: log_loss)
MODEL_SELECTION_MODE=max
MODEL_SELECTION_TOP_K=5

# ---- Viewer de resultados (churn-results, sem inferência) ----
# Fonte dos resultados: postgres (padrão) ou csv.
RESULTS_SOURCE=postgres

# PostgreSQL. No Railway, referencie o serviço: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_SCHEMA=public
DB_TABLE=churn_results
# DB_SSLMODE=require

# Modo local/testes: leia de um arquivo em vez do banco.
# RESULTS_SOURCE=csv
# RESULTS_PATH=data/sample_predictions.csv

# CHURN_THRESHOLD=0.5
# PAGE_SIZE=25
# Sobrescreva os nomes das colunas se necessário
# ID_COLUMN=customer_id
# PROBABILITY_COLUMN=churn_probability
# PREDICTION_COLUMN=churn_prediction

